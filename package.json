{
  "name": "airbnb-testing-suite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 127.0.0.1",
    "cypress:open": "node scripts/cypress.js open --e2e --browser chrome",
    "cypress:run": "node scripts/cypress.js run --e2e --browser chrome",
    "build": "vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cypress": "^14.0.0",
    "mochawesome": "^7.1.3",
    "vite": "^6.0.5"
  }
}
